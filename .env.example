# Copy this file to .env and paste your Anthropic API key after the "=".
# Without a key the server still serves the pages; analysis results are simulated.
ANTHROPIC_API_KEY=

# Optional. Set a fixed port (default 3000).
# PORT=3000

# Optional. The server listens on all interfaces by default so a phone on the same
# Wi-Fi can open the patient page. Set HOST=127.0.0.1 to keep it on this computer only.
# HOST=127.0.0.1
